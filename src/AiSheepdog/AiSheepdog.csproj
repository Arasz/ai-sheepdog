<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <PackageId>ai-sheepdog</PackageId>
        <ToolCommandName>sheepdog</ToolCommandName>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>ai agent agents harness llm cli tool dotnet-tool dotnet</PackageTags>
        <PackageReleaseNotes>https://github.com/Arasz/ai-sheepdog/releases</PackageReleaseNotes>
        <Authors>Rafał Araszkiewicz</Authors>
        <Copyright>Copyright (c) 2026 Rafał Araszkiewicz</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Arasz/ai-sheepdog</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Arasz/ai-sheepdog</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>A minimal LLM agent harness, distributed as a dotnet tool. Work in progress.</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" NoWarn="NU1507"/>
        <PackageReference Include="Spectre.Console.Cli"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AiSheepdog.Tests"/>
    </ItemGroup>

</Project>
