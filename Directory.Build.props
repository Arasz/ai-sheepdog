<Project>
    <PropertyGroup>
        <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <PackageOutputPath>$(MSBuildThisFileDirectory).nupkg/</PackageOutputPath>
    </PropertyGroup>

    <Target Name="ValidateVersionFile" BeforeTargets="Restore;Build;Pack">
        <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d+\.\d+$'))"
               Text="VERSION at the repo root must hold a bare semver (e.g. 1.2.3); found '$(Version)'."/>
    </Target>

    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>
</Project>
